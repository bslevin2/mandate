# Copy to .env and fill in values. See README → Configuration.
# Without keys the console uses local policy fallbacks + inference simulator.

# Flag client (browser) — streaming kill when you flip decisioner.live
# LaunchDarkly client-side ID
VITE_LD_CLIENT_ID=

# Flag / decision-config server SDK (never expose to the browser)
# LaunchDarkly server SDK key
LD_SDK_KEY=

# Decision config key (default mandate-decisioner)
LD_AI_CONFIG_KEY=mandate-decisioner

# Live inference — OpenAI-compatible chat completions. Server only. Never put this in VITE_*.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-nano
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash-lite
# Audience inference policies (CSV). Cheap/price for sandbox; strong/latency for prod-high.
OPENROUTER_CHEAP_MODELS=openai/gpt-4.1-nano,google/gemini-2.5-flash-lite
OPENROUTER_STRONG_MODELS=openai/gpt-4.1-nano,google/gemini-2.5-flash-lite
OPENROUTER_TIMEOUT_MS=8000

# Optional ops webhook (Slack incoming webhook or similar)
OPS_WEBHOOK_URL=

# Local API
PORT=8787
