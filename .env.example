# Copy to .env and fill in values.
# Create a LaunchDarkly trial project; use the client-side ID in the browser
# and the server-side SDK key on the API. Create flags documented in README.

# LaunchDarkly — client-side ID (browser). Comments in src/main.tsx mark where this is required.
VITE_LD_CLIENT_ID=

# LaunchDarkly — server-side SDK key (never expose to the browser).
LD_SDK_KEY=

# LaunchDarkly AI Config key (create in LD → AI Configs). Fallback prompt used if missing.
LD_AI_CONFIG_KEY=mandate-decisioner

# OpenRouter — server only. Never put this in VITE_* vars.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_MS=8000

# Optional ops webhook (Slack incoming webhook or similar). Fired on kill and cost spikes.
OPS_WEBHOOK_URL=

# Local API
PORT=8787
